#!/usr/bin/env bash
# Boots the Malrynth M0 image under QEMU and asserts the exact success marker.
#
# This is the boot smoke test. Its contract:
#
#   * QEMU is started headless with serial captured to a file.
#   * The log is polled for the success marker, the failure marker, or a timeout.
#   * QEMU is terminated deterministically in every path, including on interrupt.
#   * Exit status is 0 ONLY if the success marker appeared AND the failure marker did not.
#
# It must never pass merely because QEMU exited: a firmware that drops to the UEFI shell
# also "exits cleanly", and so does a triple fault with -no-reboot.
#
# Usage: tools/run-qemu [--timeout SECONDS] [--interactive] [--quiet]

source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

TIMEOUT=60
INTERACTIVE=0
QUIET=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --interactive) INTERACTIVE=1; shift ;;
        --quiet) QUIET=1; shift ;;
        -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

need_cmd qemu-system-x86_64

[[ -f "${ESP_DIR}/EFI/BOOT/BOOTX64.EFI" ]] \
    || die "no boot image; run tools/build first"
[[ -f "${ESP_DIR}/malrynth/kernel.elf" ]] \
    || die "no kernel image; run tools/build first"

read -r OVMF_CODE OVMF_VARS < <(find_ovmf) \
    || die "OVMF firmware not found. Install the 'ovmf' package (Debian/Ubuntu) or
        'edk2-ovmf' (Fedora/Arch). tools/doctor lists the paths probed."

mkdir -p "${BUILD_DIR}"
SERIAL_LOG="${BUILD_DIR}/serial.log"
VARS_COPY="${BUILD_DIR}/OVMF_VARS.fd"

# The variable store must be writable and must start from a pristine copy every run:
# a carried-over store makes boot order depend on previous runs, which would make this
# test non-deterministic in exactly the way a boot test must not be.
cp -f "${OVMF_VARS}" "${VARS_COPY}"
: > "${SERIAL_LOG}"

QEMU_PID=""
cleanup() {
    if [[ -n "${QEMU_PID}" ]] && kill -0 "${QEMU_PID}" 2>/dev/null; then
        kill -TERM "${QEMU_PID}" 2>/dev/null || true
        # Give QEMU a moment to exit on its own, then insist.
        for _ in $(seq 1 20); do
            kill -0 "${QEMU_PID}" 2>/dev/null || return 0
            sleep 0.1
        done
        kill -KILL "${QEMU_PID}" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# -machine q35     : the modern chipset Malrynth targets (PCIe, AHCI, no legacy PIIX).
# -m 1024          : must exceed KERNEL_PHYS_BASE (256 MiB) with room for the image.
# -cpu qemu64      : a deliberately plain CPU model; M0 must not depend on host features.
# pflash CODE/VARS : the split OVMF layout, code read-only, variables writable.
# fat:rw:esp       : QEMU's virtual FAT. Avoids needing root or mtools to build an ESP;
#                    see docs/roadmap/M0.md for the real-image gap this leaves.
# -display none    : headless. GOP is still provided by the default VGA device, so the
#                    framebuffer discovery path is genuinely exercised.
# -no-reboot       : a triple fault stops the VM instead of silently rebooting forever.
QEMU_ARGS=(
    -machine q35
    -m 1024
    -cpu qemu64
    -drive "if=pflash,format=raw,readonly=on,file=${OVMF_CODE}"
    -drive "if=pflash,format=raw,file=${VARS_COPY}"
    -drive "format=raw,file=fat:rw:${ESP_DIR}"
    -display none
    -net none
    -no-reboot
)

if [[ "${INTERACTIVE}" == "1" ]]; then
    info "starting QEMU interactively (Ctrl-A X to quit)"
    exec qemu-system-x86_64 "${QEMU_ARGS[@]}" -serial mon:stdio
fi

info "booting Malrynth M0 under QEMU (timeout ${TIMEOUT}s)"
qemu-system-x86_64 "${QEMU_ARGS[@]}" -serial "file:${SERIAL_LOG}" \
    >"${BUILD_DIR}/qemu.stderr" 2>&1 &
QEMU_PID=$!

result="timeout"
deadline=$(( SECONDS + TIMEOUT ))
while (( SECONDS < deadline )); do
    if grep -qF "${BOOT_FAIL_MARKER}" "${SERIAL_LOG}" 2>/dev/null; then
        result="fail-marker"; break
    fi
    if grep -qF "${BOOT_OK_MARKER}" "${SERIAL_LOG}" 2>/dev/null; then
        result="ok"; break
    fi
    if ! kill -0 "${QEMU_PID}" 2>/dev/null; then
        # QEMU exited before emitting any marker. This is a failure, not a success.
        result="qemu-exited"; break
    fi
    sleep 0.2
done

cleanup
QEMU_PID=""

if [[ "${QUIET}" != "1" ]]; then
    echo "----- serial output -----"
    # Strip the ANSI escapes OVMF emits when it probes the console.
    sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' -e 's/\x1b\[=[0-9]*h//g' "${SERIAL_LOG}" \
        | grep -v '^\s*$' || true
    echo "-------------------------"
fi

case "${result}" in
    ok)
        ok "boot succeeded: observed ${BOOT_OK_MARKER}"
        exit 0 ;;
    fail-marker)
        fail "kernel reported failure: observed ${BOOT_FAIL_MARKER}"
        exit 1 ;;
    qemu-exited)
        fail "QEMU exited without emitting any marker (see ${BUILD_DIR}/qemu.stderr)"
        exit 1 ;;
    timeout)
        fail "timed out after ${TIMEOUT}s without observing ${BOOT_OK_MARKER}"
        exit 1 ;;
esac
