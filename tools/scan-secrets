#!/usr/bin/env bash
# Scans for credentials that must never enter the repository.
#
# This is a PREVENTION control, not a detection guarantee. It exists because GitHub's secret
# scanning and push protection are unavailable for private repositories on this account's
# plan, so there is no server-side net (docs/security/SECRETS-POLICY.md).
#
# Usage:
#   tools/scan-secrets              scan tracked files in the working tree
#   tools/scan-secrets --staged     scan staged content (used by the pre-commit hook)
#   tools/scan-secrets --history    scan every blob in every commit (used before publishing)

source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"
cd "${MALRYNTH_ROOT}"

MODE="worktree"
[[ "${1:-}" == "--staged" ]] && MODE="staged"
[[ "${1:-}" == "--history" ]] && MODE="history"

# Malrynth pattern-list marker: not a credential
# Patterns target credential SHAPES, not the word "secret", to keep false positives low.
PATTERNS=(
    'AKIA[0-9A-Z]{16}'                        # AWS access key id
    'ghp_[A-Za-z0-9]{36}'                     # GitHub personal access token
    'gho_[A-Za-z0-9]{36}'                     # GitHub OAuth token
    'ghs_[A-Za-z0-9]{36}'                     # GitHub server token
    'github_pat_[A-Za-z0-9_]{22,}'            # GitHub fine-grained PAT
    'sk-[A-Za-z0-9]{32,}'                     # OpenAI-style key
    'xox[baprs]-[A-Za-z0-9-]{10,}'            # Slack token
    'AIza[0-9A-Za-z_-]{35}'                   # Google API key
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'      # any private key
    'PRIVATE KEY BLOCK'                       # PGP private key block
    'aws_secret_access_key[[:space:]]*='      # AWS credentials file
)
# Filenames that should never be tracked at all.
NAME_PATTERNS='(^|/)(\.env(\..*)?|id_rsa|id_ed25519|id_ecdsa|.*\.pem|.*\.p12|.*\.pfx|secrets\.toml)$'

hits=0

report() { fail "potential secret: $1"; hits=$((hits + 1)); }

case "${MODE}" in
    staged)   files=$(git diff --cached --name-only --diff-filter=ACM) ;;
    worktree) files=$(git ls-files) ;;
    history)  files="" ;;
esac

if [[ "${MODE}" != "history" ]]; then
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        if [[ "$f" =~ $NAME_PATTERNS ]]; then
            report "${f} (filename indicates credential material)"
            continue
        fi
        # This script necessarily contains every pattern it searches for; scanning it
        # would report a definition as a finding.
        [[ "$f" == "tools/scan-secrets" ]] && continue
        [[ -f "$f" ]] || continue
        # Skip binaries: grep on them is noise, and ARTIFACT-POLICY.md forbids them anyway.
        file --mime-encoding "$f" 2>/dev/null | grep -q binary && continue
        content=$(if [[ "${MODE}" == "staged" ]]; then git show ":$f" 2>/dev/null; else cat "$f"; fi)
        for p in "${PATTERNS[@]}"; do
            if printf '%s' "${content}" | grep -Eq -- "$p"; then
                report "${f} matches /${p}/"
            fi
        done
    done <<< "${files}"
else
    info "scanning full history (every blob in every commit)"
    # Every blob ever referenced, not just those reachable in the current tree. A file
    # deleted in a later commit is still present in history and still leaked.
    # The scanner's own blobs are skipped for the same reason as above; they are
    # identified by content signature rather than by path, since paths vary across history.
    self_sha=$(git rev-parse HEAD:tools/scan-secrets 2>/dev/null || true)
    while read -r _ type sha _; do
        [[ "$type" == "blob" ]] || continue
        content=$(git cat-file blob "$sha" 2>/dev/null | head -c 1000000) || continue
        printf '%s' "${content}" | grep -q 'Malrynth pattern-list marker: not a credential' && continue
        for p in "${PATTERNS[@]}"; do
            if printf '%s' "${content}" | grep -Eq -- "$p"; then
                report "blob ${sha} matches /${p}/"
            fi
        done
    done < <(git rev-list --objects --all 2>/dev/null \
             | git cat-file --batch-check='%(objectname) %(objecttype) %(objectname) %(rest)' 2>/dev/null)

    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        [[ "$name" =~ $NAME_PATTERNS ]] && report "history contains path: ${name}"
    done < <(git log --all --pretty=format: --name-only --diff-filter=A 2>/dev/null | sort -u)
fi

if (( hits > 0 )); then
    fail "${hits} potential secret(s) found -- see docs/security/SECRETS-POLICY.md"
    fail "if a secret was already pushed: ROTATE IT FIRST, then clean history"
    exit 1
fi
ok "no secrets detected (${MODE})"
